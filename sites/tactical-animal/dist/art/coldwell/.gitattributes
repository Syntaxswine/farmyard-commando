# Runtime/build text uses stable LF; verified source bytes stay verbatim.
* text eol=lf
*.gz -text
*.png -text
source/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
upstream/*.original.js -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
upstream/*NOTICE.md -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
